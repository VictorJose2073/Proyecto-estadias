# Copia este archivo como .env y genera valores propios para cada secreto.
# Un valor se genera con: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"

HOST=0.0.0.0
PORT=1337

# Cuatro valores separados por comas
APP_KEYS=cambiar1,cambiar2,cambiar3,cambiar4
ADMIN_JWT_SECRET=cambiar
API_TOKEN_SALT=cambiar
TRANSFER_TOKEN_SALT=cambiar
ENCRYPTION_KEY=cambiar
JWT_SECRET=cambiar

# Orígenes que pueden consultar la API desde el navegador, separados por comas
CORS_ORIGINS=http://localhost:5173

# Base de datos: sqlite en desarrollo; postgres o mysql en producción
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
