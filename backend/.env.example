# Copia este archivo como .env y genera valores propios para cada secreto.
# Un valor se genera con: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"

HOST=0.0.0.0
PORT=1338

# Cuatro valores separados por comas
APP_KEYS=cambiar1,cambiar2,cambiar3,cambiar4
ADMIN_JWT_SECRET=cambiar
API_TOKEN_SALT=cambiar
TRANSFER_TOKEN_SALT=cambiar
ENCRYPTION_KEY=cambiar
JWT_SECRET=cambiar

# Orígenes que pueden consultar la API desde el navegador, separados por comas
CORS_ORIGINS=http://localhost:5173

# Base de datos: PostgreSQL
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=hrl
DATABASE_USERNAME=hrl_app
DATABASE_PASSWORD=cambiar
DATABASE_SSL=false

# SQLite anterior; solo lo lee "npm run migrar:postgres" para copiar los datos
DATABASE_FILENAME=.tmp/data.db

# Solo producción (Railway)
# PUBLIC_URL=https://<servicio>.up.railway.app
# IS_PROXIED=true
# DATABASE_URL=${{Postgres.DATABASE_URL}}
