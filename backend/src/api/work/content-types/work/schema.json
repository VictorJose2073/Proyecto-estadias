{
  "kind": "collectionType",
  "collectionName": "works",
  "info": {
    "singularName": "work",
    "pluralName": "works",
    "displayName": "Blog - Trabajo"
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title" },
    "workDate": { "type": "date", "required": true },
    "device": { "type": "string" },
    "technician": { "type": "string" },
    "summary": { "type": "text", "required": true },
    "details": { "type": "richtext" },
    "consentimientoCliente": { "type": "boolean", "required": true, "default": false },
    "photos": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "works"
    }
  }
}
