# URL del CMS Strapi (copia este archivo como .env.local)
VITE_STRAPI_URL=http://localhost:1338

# Firebase: Consola → Configuración del proyecto → Tus apps → app web → firebaseConfig.
# Si se dejan vacías, el portal de seguimiento usa la orden de demostración DEMO-001.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
